# --- required in production ---
DATABASE_URL=postgres://user:password@host:5432/placementos
ADMIN_EMAIL=placement@yourcollege.edu
ADMIN_PASSWORD=choose-a-long-random-password
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Letters/digits/-/_ only, >=24 chars. Part of the MCP URL: https://<host>/mcp/<MCP_SECRET>
MCP_SECRET=generate-with-openssl-rand-hex-24
# Public origin used in student links (Render's RENDER_EXTERNAL_URL is used if this is unset)
PUBLIC_BASE_URL=https://placementos.onrender.com
# --- optional ---
NODE_ENV=production
# DATABASE_SSL=true            # forced automatically for *.render.com hosts
# CORS_ORIGINS=https://other.example   # only if a separate frontend origin is used
# NOTE: there are intentionally NO AI provider keys anywhere in this project.
